# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# MySQL Connection Pool
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=umanarayani
DB_CONNECTION_LIMIT=10

# Security Configuration & Whitelisted Origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_SECRET=replace_with_a_cryptographically_secure_random_string_32_chars_min
ADMIN_SECRET_KEY=replace_with_strong_admin_key
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NODE_ENV=development

# Email OTP Service (Nodemailer via Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_EMAIL=your-support-email@gmail.com
SMTP_PASS=your_16_letter_google_app_password

# SMS OTP Service (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
