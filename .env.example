# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# MySQL Connection Pool
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=umanarayani
DB_CONNECTION_LIMIT=10

# Security Configuration & Whitelisted Origins (Production: https://umanarayni.com, https://www.umanarayni.com)
ALLOWED_ORIGINS=https://umanarayni.com,https://www.umanarayni.com
SESSION_SECRET=replace_with_a_cryptographically_secure_random_string_32_chars_min
ADMIN_SECRET_KEY=replace_with_strong_admin_key
ADMIN_EMAIL=admin@umanarayni.com,pushpendra@umanarayni.com

# Optional Admin IP Allowlist (comma-separated IPv4/IPv6 addresses permitted to access admin panel; leave empty to permit all IPs with TOTP)
ADMIN_IP_ALLOWLIST=

# Server Secret for Keyed HMAC-SHA256 OTP Hashing (prevents rainbow-table attacks against 6-digit OTP space)
OTP_HMAC_SECRET=replace_with_a_random_hmac_secret_string

# Server Secret for Keyed Password Reset Token Hashing (prevents reset token forgery)
RESET_TOKEN_SECRET=replace_with_a_random_reset_token_secret_string

# OTP & Password Recovery Timing & Security Constraints
OTP_EXPIRY_MINUTES=5
RESET_TOKEN_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_HOURLY_PER_IDENTIFIER=3
OTP_MAX_ATTEMPTS=5

# Daily SMS Limit: Cap total outgoing Twilio SMS per calendar day to protect against runaway billing
TWILIO_DAILY_SMS_LIMIT=100

# Rate Limiting: Tuned default max requests per 15-minute window for mobile CGNAT (Jio, Airtel) users sharing gateway IPs
GLOBAL_RATE_LIMIT_MAX=1200

# Trust Proxy Setting (1 for standard Nginx / Cloudflare reverse proxy hop, or loopback)
TRUST_PROXY=1

# Cloudflare Turnstile Bot Defense
# Generate production keys at https://dash.cloudflare.com/?to=/:account/turnstile
# (Replace test keys 1x0000... to eliminate the "For testing only" banner)
TURNSTILE_SITE_KEY=your_production_turnstile_site_key
TURNSTILE_SECRET_KEY=your_production_turnstile_secret_key
# Server Secret for Signing Human Verification Cookies (Cart & Checkout Frictionless Bot Bypass)
HUMAN_VERIFY_SECRET=replace_with_a_random_human_verify_secret_string
# Verification Cookie Lifetime in Seconds (Default: 1800 seconds = 30 minutes)
HUMAN_VERIFIED_MAX_AGE_SECONDS=1800
NODE_ENV=production

# Email OTP Service (Nodemailer via Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_EMAIL=your-support-email@gmail.com
SMTP_PASS=your_16_letter_google_app_password

# SMS OTP Service (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# PhonePe Payment Gateway (Standard Checkout - UAT Sandbox)
PHONEPE_MERCHANT_ID=PGTESTPAYUAT
PHONEPE_SALT_KEY=099eb0cd-02cf-4e2a-8aca-3e6c6aff0399
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=UAT
PHONEPE_BASE_URL=https://api-preprod.phonepe.com/apis/pg-sandbox

# Order Integrity & Reconciliation Settings
# Auto-expire unverified manual UPI/UTR orders after the specified hours (Default: 24)
UTR_ORDER_EXPIRY_HOURS=24

# Pincode Serviceability Check
# Comma-separated 2-digit or 3-digit pincode prefixes that can be serviced (e.g. 11,12,20,30,40,56).
# Set to * or leave empty to deliver to all valid 6-digit Indian PIN codes nationwide.
SERVICEABLE_PINCODE_PREFIXES=*

# Automated Database Backup & Amazon S3 Cloud Storage
# When S3_BACKUP_BUCKET is configured, nightly backups are encrypted (SSE-S3 AES-256) and uploaded offsite.
# Local copies in backups/ are retained for 7 days via rolling purge.
BACKUP_CRON_SCHEDULE=0 2 * * *
S3_BACKUP_BUCKET=
S3_BACKUP_PREFIX=database-backups/
AWS_REGION=ap-south-1
# AWS credentials can be left blank if running on EC2 with an attached IAM Role
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Administrative Alerting
# Email recipient for critical system alerts (database backup failure, S3 failure)
ADMIN_ALERT_EMAIL=admin@umanarayni.com
NOTIFY_BACKUP_SUCCESS=false

# Error Monitoring & Observability (Sentry)
# Set ENABLE_SENTRY=true and provide your Sentry DSN to enable real-time exception tracking
ENABLE_SENTRY=false
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

# Structured JSON Logging
# Set to true to emit machine-parseable JSON logs in production (CloudWatch, Datadog, ELK)
STRUCTURED_LOGS=false

